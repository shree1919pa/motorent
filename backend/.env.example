# ==============================================================================
# MotoRent Backend - Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# Server Port (Render automatically sets PORT in production)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.zasnvdl.mongodb.net/motorent?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/motorent?retryWrites=true&w=majority

# Optional: Target database name (if not specified at the end of MONGODB_URI)
DB_NAME=motorent

# JWT Secret Key for authenticating client, owner, and admin sessions
# Use a strong, random 32+ character string in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_or_more

# Frontend URL (Used for CORS in production)
# Example: https://motorent-frontend.onrender.com
FRONTEND_URL=https://your-frontend-service.onrender.com

# Optional additional CORS origins (comma-separated)
CORS_ORIGIN=https://your-custom-domain.com

# ------------------------------------------------------------------------------
# Cloudinary Storage Configuration (Recommended for Render Production)
# Render web service storage is ephemeral. Cloudinary provides permanent image
# storage for bikes, driving licenses, payment screenshots, and QR codes.
# If omitted, uploads fall back to local disk storage in backend/uploads/.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Default Administrator Account (Seeded automatically if no admin exists)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@motorent.com
ADMIN_PASSWORD=AdminSecurePassword123!

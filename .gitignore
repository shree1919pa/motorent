# ==============================================================================
# Root .gitignore for MotoRent
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Environment files and credentials (NEVER commit secrets to git)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Production builds
dist/
dist-ssr/
frontend/dist/

# Uploads and ephemeral files (keep directory structure via .gitkeep)
backend/uploads/bikes/*
!backend/uploads/bikes/.gitkeep
backend/uploads/licenses/*
!backend/uploads/licenses/.gitkeep
backend/uploads/qrcodes/*
!backend/uploads/qrcodes/.gitkeep
backend/uploads/payments/*
!backend/uploads/payments/.gitkeep
backend/uploads/profiles/*
!backend/uploads/profiles/.gitkeep

# System and editor files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
.vscode/
.idea/
